{
  "name": "Brand Name",
  "slug": "brand-slug",
  "version": "1.0.0",
  "colors": {
    "primary": "#000000",
    "primary-foreground": "#ffffff",
    "secondary": "#f5f5f5",
    "secondary-foreground": "#000000",
    "accent": "#0070f3",
    "background": "#ffffff",
    "foreground": "#111111",
    "muted": "#888888",
    "border": "#e5e5e5"
  },
  "typography": {
    "title": {
      "family": "Font Name",
      "weights": [400, 700],
      "css": "media/{brand-slug}/fonts/{family}/{family}.css"
    },
    "paragraph": {
      "family": "Font Name",
      "weights": [400, 500, 600],
      "css": "media/{brand-slug}/fonts/{family}/{family}.css"
    }
  },
  "logos": {
    "primary-light": "media/{brand-slug}/logos/primary/logo-primary-light.svg",
    "primary-dark": "media/{brand-slug}/logos/primary/logo-primary-dark.svg",
    "icon": "media/{brand-slug}/logos/icon/icon.svg",
    "wordmark": "media/{brand-slug}/logos/wordmark/wordmark-light.svg"
  },
  "icons": {
    "favicon": "media/{brand-slug}/icons/favicon.ico",
    "favicon-32": "media/{brand-slug}/icons/favicon-32.png",
    "apple-touch-icon": "media/{brand-slug}/icons/apple-touch-icon.png"
  },
  "guidelines": {
    "min-clearspace": "0.5x logo height",
    "bg-allowed": ["white", "black", "primary"],
    "dont": ["stretch", "rotate", "recolor"]
  }
}
